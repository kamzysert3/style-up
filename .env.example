# Copy to .env and fill in. .env is gitignored — never commit your key.
GEMINI_API_KEY=your-google-ai-studio-key-here
# Shared secret for /score. Set it before the proxy is reachable from outside your
# LAN (Cloudflare, a tunnel, port forwarding), then enter the same value in the app
# under Settings. Unset = anyone who can reach the port can spend your Gemini quota.
# PROXY_TOKEN=some-long-random-string
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=20000
# GEMINI_HEDGE_MS=4000
# GEMINI_TEMPERATURE=0          # 0 = most repeatable score for the same photo
# GEMINI_SAMPLES=1              # score each photo N times (max 5), keep the median; costs N calls
#
# Calibrating? Pin one model so every score sits on the same scale:
# GEMINI_FALLBACK_MODELS=
# PORT=8787
